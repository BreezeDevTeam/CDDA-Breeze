#. ~ Snippet in category "lab_safety_snippet"
#. ~ signage for research scientist levels (working lab areas).
#: data/json/snippets/lab_signs.json
msgid ""
"<color_white_red>THINK!</color>\n"
"<color_white_red>DON'T CONTAMINATE!</color>\n"
"<color_white>Don't store food in sample refrigerators!</color>"
msgstr ""
