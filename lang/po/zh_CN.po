msgid "Load mill with what kind of product?"
msgstr "给碾磨机放入什么制品？"

#: src/iexamine.cpp:6030
msgid "You don't have any products that can be milled."
msgstr "你没有任何可以碾磨的制品。"

#: src/iexamine.cpp:6052
#, c-format
msgid "Insert how many %s into the mill?"
msgstr "放入多少%s到碾磨机里？"

#: src/iexamine.cpp:6065
msgid "You don't have that many."
msgstr "你没有那么多。"

#: src/iexamine.cpp:6068
msgid "You can't place that many."
msgstr "你不能放那么多。"

#: src/iexamine.cpp:6089
#, c-format
msgid "You carefully place %1$d %2$s in the mill."
msgstr "你小心地将 %1$d %2$s 放进碾磨机里。"

