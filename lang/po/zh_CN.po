msgid "Why should I teach you?"
msgstr "凭什么要我教你？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Come on, we're friends."
msgstr "得了吧，我们可是朋友。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Forget it, let's get going."
msgstr "算了。我们该走了。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Why should I host a training seminar?"
msgstr "我为什么要开始培训？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "OVERRIDE: "
msgstr "临时指令："

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Follow same rules as this follower."
msgstr "遵守和这名同伴一样的规则。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't pick up items."
msgstr "不要拾取物品。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You can pick up items now."
msgstr "可以拾取物品。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't bash obstacles."
msgstr "不要清除障碍物。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You can bash obstacles."
msgstr "可以清除障碍物。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Stay awake."
msgstr "尽力保持清醒。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sleep when you feel tired."
msgstr "疲倦的时候就睡觉吧。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Stay quiet."
msgstr "尽量保持安静。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Tell me when you need something."
msgstr "当你需要什么的时候就告诉我。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Leave corpses alone."
msgstr "不用理会尸体。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Smash zombie corpses."
msgstr "砸碎丧尸尸体。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Leave doors open."
msgstr "记得让门开着。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Close the doors."
msgstr "记得随手关门。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Open doors to get where you're going."
msgstr "你可以打开门去你要去的地方。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't walk through closed doors."
msgstr "不要穿过关着的门。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "If you hear a noise but can't see the source, move to investigate it."
msgstr "如果你听到噪音但是看不到来源，去调查它。"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't investigate noises that you can't see."
msgstr "不要调查你看不见的地方的噪音。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Set up pickup rules."
msgstr "设置拾取物品规则。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Clear all overrides."
msgstr "清除所有临时指令。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You're really leaving?"
msgstr "你真的要离开？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Yeah, I'm sure.  Bye."
msgstr "[确认]是的，再见吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Nah, I'm just kidding."
msgstr "[取消]我只是在开个玩笑。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go to this location…"
msgstr "请到这个地方去……"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Stay at your current position."
msgstr "守在你现在的位置。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm currently <current_activity>."
msgstr "我正在<current_activity>。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm not doing much currently."
msgstr "我现在没有任务。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I meant what are your goals?"
msgstr "你现在有什么想要做的吗？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Carry on."
msgstr "继续。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please stop your current activity."
msgstr "请停止当前的工作吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please sort out some of these items nearby."
msgstr "整理下周围的物品。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please do any construction work that you can."
msgstr "完成所有未完成的建筑工程。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please do any mining work that you can."
msgstr "尽可能地挖矿。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go mop the area."
msgstr "请把地拖干净。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please study from a book."
msgstr "请看书学习。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please start deconstructing any vehicles in a deconstruction zone."
msgstr "开始拆解停在拆解区里的载具。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please start repairing any vehicles in a repair zone."
msgstr "请开始修复停在修复区里的载具。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please chop logs into planks."
msgstr "把原木劈成木板。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please butcher any corpses that you can."
msgstr "尽可能地屠宰尸体。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please chop any trees in the designated areas."
msgstr "去伐木区砍树。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go catch some fish."
msgstr "去钓点鱼。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please do some farming work."
msgstr "做些农活。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please disassemble anything in the designated areas."
msgstr "去拆解区拆解物品。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*pssshht* ten-four, I'll make my way there, over."
msgstr "*电流声* 收到，我会赶过去的。完毕。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sure thing, I'll make my way there."
msgstr "好的，我会赶过去的。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What about the camp?"
msgstr "谈点关于营地的事好吗？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I want to assign you to work at this camp."
msgstr "[指派]我想派你去这个营地工作。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Please go to this location."
msgstr "请到这个地方。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"Since we can't build a camp here, I want you to tell me where can we build a"
" camp?"
msgstr "既然我们不能在这里建立营地，你告诉我在哪里可以建？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Are you sure?"
msgstr "你确定？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Yes, I'm sure."
msgstr "是的，我确定。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "Actually, never mind."
msgstr "呃，其实没什么。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Another survivor!  We should travel together."
msgstr "[组队]另一名幸存者！让我们组队行动吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "What are you doing?"
msgstr "[询问]你在做些什么？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put away weapon."
msgstr "收起武器。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Drop weapon."
msgstr "放下武器。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Don't worry, I'm not going to hurt you"
msgstr "别担心，我不打算伤害你。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Drop your weapon!"
msgstr "把你的武器放下！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Get out of here or I'll kill you."
msgstr "给老子滚开，否则我杀了你。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Hey there, <name_g>."
msgstr "嘿，<name_g>。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
msgid "Hello there."
msgstr "你好。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Okay, no sudden movements…"
msgstr "好吧，别乱动……"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Keep your distance!"
msgstr "离我远点！"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "This is my territory, <name_b>."
msgstr "这是我的地盘，<name_b>。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Calm down.  I'm not going to hurt you."
msgstr "冷静点，我不会伤害你。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Screw you, no."
msgstr "去你妈的！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put hands up."
msgstr "举起双手。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops his weapon."
msgstr "*放下他的武器。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops her weapon."
msgstr "*放下她的武器。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here"
msgstr "现在赶紧滚"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here, before I kill you."
msgstr "在我杀了你之前，从这里滚开。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/holdouts/Rural-Cowboy_Hostile.json
msgid "Okay, I'm going."
msgstr "好好，我现在就走。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "About one of those jobs…"
msgstr "关于其中的一个任务……"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What's the matter?"
msgstr "你怎么了？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't care."
msgstr "我不在乎。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't have any jobs for you."
msgstr "我没有工作可以给你。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I don't have any more jobs for you."
msgstr "我没有更多的工作可以给你了。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have other jobs for you.  Want to hear about them?"
msgstr "我还有些其它的工作想交给你，要听听看吗？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have more jobs for you.  Want to hear about them?"
msgstr "我还有更多的工作想交给你，要听听看吗？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I have a job for you.  Want to hear about it?"
msgstr "我有一份活给你，想听听吗？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I just have one job for you.  Want to hear about it?"
msgstr "我这正好有份你能做的事，想听听吗？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
msgid "Oh, okay."
msgstr "哦，好的。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Never mind, I'm not interested."
msgstr "[拒绝]算了，我没兴趣。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "You're not working on anything for me now."
msgstr "你现在没有为我做任何事情。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Which job?"
msgstr "哪个工作？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What about it?"
msgstr "怎么样了？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'll do it!"
msgstr "[确认]我去做吧！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Not a problem."
msgstr "没问题，然后呢？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Got any advice?"
msgstr "能给点建议吗？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Can you share some equipment?"
msgstr "能给点装备吗？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'll be back soon!"
msgstr "我很快就回来！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
msgid "Sounds good, thanks."
msgstr "明白了，谢谢。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sounds good.  Bye!"
msgstr "我懂了，再见！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk_fluff.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
msgid "I'm sorry."
msgstr "[重复]抱歉，我再考虑一下？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Whatever.  Bye."
msgstr "[取消]无所谓，再见！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'm sorry… I failed."
msgstr "对不起……我失败了。"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed him."
msgstr "我杀了他。"

#. ~ Negative response to NPC dialogue
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed it."
msgstr "我杀了它。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "No.  I'll get back to it, bye!"
msgstr "没有，我会继续做的，再见！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Yup!  Here it is!"
msgstr "当然了，就在这儿！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "We're here!"
msgstr "我们到了！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Here I am."
msgstr "我在这里。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I talked to them."
msgstr "我和他谈过了。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Here it is!"
msgstr "就是它了！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Justice has been served."
msgstr "如你所愿，正义已经得到了伸张。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I killed them.  All of them."
msgstr "我杀光了它们。它们全部。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I brought 'em."
msgstr "我花了点钱买下了。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I've taken care of it"
msgstr "我已经搞定了。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid ""
"I found it, but I'm keeping it, and I'll find you another one.  Let's talk "
"about something else."
msgstr "找到了，但这一份我要自己留着，我会再去找一份的。现在我们讨论些别的。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I found it, but I'm keeping it, and I'll find you another one.  Bye!"
msgstr "找到了，但这一份我要自己留着，我会再去找一份的。再见！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Mission success!  I don't know what else to say."
msgstr "任务成功了！我不知道还能说什么。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment."
msgstr "我不需要报酬，帮到你就很好了。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "How about some items as payment?"
msgstr "也许你可以给我点东西，作为报酬。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/NPC_Corrie_Kaja_Dosia.json
msgid "Maybe you can teach me something as payment?"
msgstr "也许你可以教我些东西，作为报酬。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment.  Bye!"
msgstr "很高兴帮到你，我不需要报酬，再见！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
msgid "Glad to help."
msgstr "很高兴可以帮忙。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Glad to help.  Bye!"
msgstr "很高兴可以帮忙。再见。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Well, um, sorry."
msgstr "呃，嗯……不好意思。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "I'm sorry.  I did what I could."
msgstr "对不起，我已经尽力了。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sure, here you go!"
msgstr "当然，给你！"

