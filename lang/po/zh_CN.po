msgid_plural "shady gallimimus zombies"
msgstr[0] "暗影丧尸似鸡龙"

#. ~ Description of monster "shady gallimimus zombie"
#. ~ Description of monster "shady struthiomimus zombie"
#. ~ Description of monster "shady ornithomimus zombie"
#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid ""
"An uncanny shadow envelops this creature.  You can make out the outline of a"
" bipedal dinosaur with feathery edges and a beak"
msgstr "一团怪诞的阴影笼罩着这个生物。你可以辨认出一只双足恐龙的轮廓，长着羽毛和喙。"

#. ~ Monster name
