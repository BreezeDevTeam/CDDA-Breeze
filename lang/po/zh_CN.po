msgstr "%s 部队撤出战斗！"

#: src/mission_companion.cpp:2245
msgid "The monsters are destroyed!"
msgstr "怪物被击杀！"

#: src/mission_companion.cpp:2247
msgid "The monsters disengage!"
msgstr "怪物们脱离了战斗！"

#: src/mission_companion.cpp:2274
#, c-format
msgid "Engagement between %d members of %s %s and %d members of %s %s%s!"
msgstr "%d个%s %s的成员和%d个%s %s%s的成员发生交战！"

