msgstr "帆布工作裤（浅蓝）"

#. ~ Item name
#: data/json/items/armor/legs_clothes.json
msgid "army winter pants"
msgid_plural "army winter pants"
msgstr[0] "防寒军装长裤"

#. ~ Description of "army winter pants"
#: data/json/items/armor/legs_clothes.json
msgid ""
"A tough pair of pants lined with pockets, thickly padded for warmth.  "
"Favored by the military."
msgstr "一条厚实的长裤，上面缝着不少口袋，有防寒衬里。军队指定用品。"

#. ~ Item name
#: data/json/items/armor/legs_clothes.json
msgid "zubon"
msgid_plural "zubons"
msgstr[0] "和服裤"

#. ~ Description of "zubon"
#: data/json/items/armor/legs_clothes.json
