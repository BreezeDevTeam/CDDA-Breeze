#: src/iexamine.cpp:6348
msgid "Inspect smoking rack"
msgstr "查看烟熏架"

#: src/iexamine.cpp:6352
msgid "Light up and smoke food… insert some food for smoking first"
msgstr "点燃并开始熏制……需要先放入需要熏制的食物"

#: src/iexamine.cpp:6354
#, c-format
