#: data/mods/Magiclysm/enchantments/Fire_Elemental.json
msgid "Fire Elemental Burnback"
msgstr "火系法术熔蚀"

#. ~ Description of spell "Fire Elemental Burnback"
#: data/mods/Magiclysm/enchantments/Fire_Elemental.json
msgid "The burnback effect from the Fire Elemental Attunement."
msgstr "火系法术魔法调谐的反噬效果。"

#. ~ Spell name
#: data/mods/Magiclysm/enchantments/Gaias_Chosen.json
msgid "Gaia's Chosen Thorns"
msgstr "盖娅神选者荆棘"

#. ~ Description of spell "Gaia's Chosen Thorns"
#: data/mods/Magiclysm/enchantments/Gaias_Chosen.json
msgid "The thorns effect from the Gaia's Chosen Attunement."
msgstr "盖娅神选者魔法调谐的荆棘效果。"

#. ~ Spell name
#: data/mods/Magiclysm/enchantments/Glacier_Mage.json
