#. ~ Snippet in category "<ally_rule_allow_sleep_true_text>"
#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will sleep when tired."
msgstr "<mypronoun>会在疲倦时睡觉。"

#. ~ Snippet in category "<ally_rule_allow_sleep_false_text>"
#: data/json/npcs/talk_tags.json
