msgstr "魔力"

#. ~ Item name
#: data/mods/Magiclysm/vehicles/summoned_vehicles.json
msgid "mana core power"
msgid_plural "mana core powers"
msgstr[0] "魔力动力"

#. ~ Description of "mana core power"
#: data/mods/Magiclysm/vehicles/summoned_vehicles.json
msgid "Seeing this is a bug."
msgstr "看见这个说明出bug了。"

