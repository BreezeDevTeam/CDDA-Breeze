#, c-format
msgid "The %s doesn't fit in the rack."
msgstr "%s 无法被放入烟熏架。"

#: src/iexamine.cpp:5975
#, c-format
msgid "You carefully place %1$d %2$s in the rack."
msgstr "你小心地将 %1$d %2$s 放进架子里。"

#: src/iexamine.cpp:5994
msgid "You can't place more food while it's milling."
msgstr "你不能在碾磨的时候放更多的食物"

