#. ~ Item name
#: data/json/items/resources/metal.json
msgid "scrap metal"
msgid_plural "scrap metals"
msgstr[0] "金属废料"

#. ~ Density 7.60g/cm³ ~ 1.9kg/250ml @ 50g/unit ~ stack 40 but fragments
#. stacks poorly so only 25% of this
#. ~ Description of "scrap metal"
#: data/json/items/resources/metal.json
msgid ""
"A bulky assortment of small bits of scrap steel useful in all kinds of "
"crafting."
msgstr "各式各样的小块金属碎片，经过整理，可用于制造各种物品。"

#. ~ Item name
