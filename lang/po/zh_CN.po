#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Diver"
msgstr "潜水员"

#. ~ Description of profession "Diver" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were enjoying the company of submarine life when you noticed something "
"weird on the nearby beach, you decided to swim away when you heard the "
"screams."
msgstr "当你在享受潜水生活时，你注意到附近海滩上有些奇怪的家伙，当你听到尖叫声时，你决定赶紧游走。"

#. ~ Profession name for female
#: data/json/professions.json
