msgid "sword bayonet"
msgid_plural "sword bayonets"
msgstr[0] "长刺刀"

#. ~ Description of "sword bayonet"
#: data/json/items/melee/swords_and_blades.json
msgid ""
"A large slashing weapon that can be attached to the front of a firearm or "
"crossbow, converting it into a pike."
msgstr "一柄安装在枪械或弩前端的大型斩击武器。可以让你的武器变成近战长矛。"

#. ~ Item name
#: data/json/items/melee/swords_and_blades.json
msgid "modified sword bayonet"
msgid_plural "modified sword bayonets"
msgstr[0] "改装长刺刀"

#. ~ Description of "modified sword bayonet"
#: data/json/items/melee/swords_and_blades.json
