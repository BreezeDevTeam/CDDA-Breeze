#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
msgid "I'm sorry…"
msgstr "对不起……"

#. ~ NPC dialogue line
#. ~ Snippet in category "schizo_self_talk"
#. ~ Snippet in category "schizo_weapon_talk_misc"
