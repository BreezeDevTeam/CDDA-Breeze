msgid_plural "sheets of reinforced glass"
msgstr[0] "强化玻璃片"

#. ~ Description of "sheet of reinforced glass"
#: data/json/items/resources/glass.json
msgid ""
"A large sheet of bulletproof glass, it looks to a little over two inches "
"thick."
msgstr "一大块防弹玻璃，看起来有两英寸厚。"

#. ~ Item name
#: data/json/items/resources/glass.json
msgid "pane of reinforced glass"
msgid_plural "panes of reinforced glass"
msgstr[0] "强化玻璃碎块"

#. ~ Description of "pane of reinforced glass"
#: data/json/items/resources/glass.json
msgid ""
"A small pane of bulletproof glass, it looks to be a little over two inches "
"thick."
msgstr "一小块防弹玻璃，看起来有两英寸厚。"

#. ~ Item name
#: data/json/items/resources/glass.json
