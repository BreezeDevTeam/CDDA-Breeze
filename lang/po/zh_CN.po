#. ~ Description of "roasted soy nuts"
#: data/json/items/comestibles/nuts.json
msgid "Roasted soybeans, often called soy nuts."
msgstr "烤大豆，通常被称为烤豆子。"

#. ~ Item name
#: data/json/items/comestibles/nuts.json
msgid "roasted hazelnuts"
