#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
#, c-format
msgid "%s initiates blade-work."
msgstr "%s 启动了生化刀术。"

#. ~ Buff name of martial art "C.R.I.T Blade-work"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid "Unwavering Edge"
msgstr "坚不可摧的刀锋"

#. ~ Description of buff "C.R.I.T Blade-work" in martial art "Unwavering Edge"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid ""
"You attack with your blade at your opponent.\n"
"\n"
"+1 cut and stab armor penetration, -2.0 Dodging skill.\n"
"Lasts 2 turns.  Stacks 2 times."
msgstr ""
"你用刀锋攻击对手。\n"
"\n"
"斩击/刺击护甲穿透 +1，闪避技能 -2。\n"
"持续 2 回合。可叠加 2 次。"

#. ~ Buff name of martial art "C.R.I.T Blade-work"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid "Ruthlessness"
msgstr "冷酷无情的面容"

#. ~ Description of buff "C.R.I.T Blade-work" in martial art "Ruthlessness"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid ""
"You continue attacking with your blade furiously.\n"
"\n"
"+1 cut and stab damage, -1 dodge attempt.\n"
"Lasts 1 turn.  Stacks 4 times."
msgstr ""
"你继续用刀锋猛斩对手。\n"
"\n"
"斩击/刺击伤害+1，闪避次数 -1。\n"
"持续 1 回合。可叠加 4 次。"

#. ~ Buff name of martial art "C.R.I.T Blade-work"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid "Rending Strikes"
msgstr "撕裂护甲的重击"

#. ~ Description of buff "C.R.I.T Blade-work" in martial art "Rending Strikes"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid ""
"You slash with your blade with a vengeance.\n"
"\n"
"+2 cut and stab armor penetration, -1 dodge attempt.\n"
"Lasts 1 turn.  Stacks 3 times."
msgstr ""
"你用刀锋狠狠地斩向对手。\n"
"\n"
"斩击/刺击护甲穿透 +2，闪避次数 -1。\n"
"持续 1 回合。可叠加 3 次。"

#. ~ Buff name of martial art "C.R.I.T Blade-work"
#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
