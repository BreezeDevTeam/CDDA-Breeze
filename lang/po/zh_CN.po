msgid "shady daspletosaurus zombie"
msgid_plural "shady daspletosaurus zombie"
msgstr[0] "暗影丧尸惧龙"

#. ~ Monster name
#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid "shady T-Rex zombie"
msgid_plural "shady T-Rex zombies"
msgstr[0] "暗影丧尸霸王龙"

#. ~ Description of monster "shady T-Rex zombie"
#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid ""
"An uncanny shadow envelops this creature.  You can make out the outline of a"
" huge, bipedal dinosaur with feathery edges.  The head looks large - lots of"
