#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"north, north, north, north, north\""
msgstr "往北，往北，往北，往北，往北"

#. ~ Speech from speaker mon_human_biomachine
#: data/mods/Aftershock/speech.json
msgid "\"Where am I?  Where am I?  Where am I?\""
msgstr "\"我在哪？我在哪？我在哪？\""

