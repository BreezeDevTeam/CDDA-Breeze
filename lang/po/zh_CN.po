#. ~ Description of "crude wooden arrow"
#: data/json/items/ranged/archery.json
msgid "A crude pointed wooden shaft with a notch at the back."
msgstr "一根粗略磨尖的木杆，末端刻有凹槽。"

#. ~ Item name
#: data/json/items/ranged/archery.json
msgid "wooden bodkin arrow"
msgid_plural "wooden bodkin arrows"
msgstr[0] "木制锥头箭"

#. ~ Description of "wooden bodkin arrow"
#: data/json/items/ranged/archery.json
msgid "A fletched wooden arrow shaft with a pointed tip."
msgstr "一根装着锋利箭头的木制羽箭。"

#. ~ Item name
#: data/json/items/ranged/archery.json
