#. ~ "msg" action message of item "turtleneck (rolled)"
#: data/json/items/tool_armor.json
msgid "You adjust the neck and collar of the turtleneck."
msgstr "你调整了高领毛衣的领口高度。"

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "turtleneck (rolled)"
msgid_plural "turtlenecks (rolled)"
msgstr[0] "高领毛衣（卷起）"

#. ~ Description of "turtleneck (rolled)"
#: data/json/items/tool_armor.json
msgid "This wool turtleneck's neck is rolled out of the way of the mouth."
msgstr "这件羊毛高领毛衣的领口卷起，露出了嘴。"

#. ~ "menu_text" action message of item "turtleneck (rolled)"
#. ~ "menu_text" action message of item "turtleneck shirt (rolled)"
#: data/json/items/tool_armor.json
