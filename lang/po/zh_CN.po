#: data/json/effects.json data/json/mutations/mutations.json
msgid "Changing"
msgstr "变异中"

#. ~ Name of effect type id "mutagen"
#: data/json/effects.json
msgid "Mutagen Overdose"
msgstr "诱变剂过量"

#. ~ Name of effect type id "mutagen"
#: data/json/effects.json
msgid "Warping"
msgstr "变形中"

#. ~ Description of effect type "Changing, Mutagen Overdose, Warping"
#: data/json/effects.json
msgid "You can feel your insides shifting.  It feels… nice."
msgstr "你能感觉到体内器官移动。感觉……很好。"

