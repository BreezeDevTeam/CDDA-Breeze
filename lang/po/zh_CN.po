#: data/json/items/ranged/archery.json
msgid "A fletched wooden arrow shaft with a bladed tip."
msgstr "一根装着宽刃箭头的木制羽箭。"

#. ~ Item name
#: data/json/items/ranged/archery.json
msgid "simple wooden arrow"
msgid_plural "simple wooden arrows"
msgstr[0] "简易木箭"

#. ~ Description of "simple wooden arrow"
