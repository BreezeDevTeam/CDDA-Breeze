msgstr "迷濛废墟"

#. ~ Overmap terrain name
#: data/mods/Aftershock/maps/overmap_terrain.json
msgid "augmentation clinic"
msgstr "人体强化诊所"

#. ~ Overmap terrain name
#: data/mods/Aftershock/maps/overmap_terrain.json
msgid "aquacultural farm"
msgstr "水产养殖场"

#. ~ Overmap terrain name
#: data/mods/Aftershock/maps/overmap_terrain.json
