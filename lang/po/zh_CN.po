msgid "You light a %s."
msgstr "你点着了 %s。"

#: src/iuse.cpp:611
msgid "Ugh, too much smoke… you feel nasty."
msgstr "啊，好多烟……你被呛到了。"

#: src/iuse.cpp:620
msgid "You take a puff from your electronic cigarette."
msgstr "你抽了一口 电子烟。"

#: src/iuse.cpp:624
