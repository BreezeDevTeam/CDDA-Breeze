msgid_plural "bronze"
msgstr[0] "青铜"

#. ~ Description of "bronze"
#: data/json/items/ammo.json
msgid "Decent-sized chunks of bronze, for fashioning some old-school items."
msgstr "一块尺寸适中的青铜，用于制造一些旧时代的物品。"

#. ~ Item name
#. ~ Name of an ammunition type
