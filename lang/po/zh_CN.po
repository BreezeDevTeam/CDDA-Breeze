msgstr "重压碾碎"

#. ~ Description of martial technique "Pressure Crunch"
#: data/mods/Aftershock/player/techniques.json
msgid "Heavy stun and knockback, 1.5x bash damage, crit only"
msgstr "击晕并击退，1.5倍钝击伤害，仅暴击"

#. ~ Message of martial technique "Pressure Crunch"
#: data/mods/Aftershock/player/techniques.json
#, c-format
msgid "You smash %s with a pressurized slam"
msgstr "你猛击击碎了%s"

#. ~ Message of martial technique "Pressure Crunch"
#: data/mods/Aftershock/player/techniques.json
#, c-format
