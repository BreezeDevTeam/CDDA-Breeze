msgstr "一把经过精心调整的普通砍刀，原本普通的园艺工具现在当作武器使用起来更加顺手。"

#. ~ Item name
#: data/json/items/melee/swords_and_blades.json
msgid "tempered combat machete"
msgid_plural "tempered combat machetes"
msgstr[0] "回火战斗砍刀"

#. ~ Description of "tempered combat machete"
#: data/json/items/melee/swords_and_blades.json
