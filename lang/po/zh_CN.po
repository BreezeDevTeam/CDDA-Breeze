#. ~ Snippet in category "schizo_weapon_drop"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "%1$s lied to you."
msgstr "%1$s 骗了你。"

#. ~ Snippet in category "schizo_weapon_drop"
#: data/json/snippets/schizophrenia.json
