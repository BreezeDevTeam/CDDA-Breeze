#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Captain"
msgstr "船长"

#. ~ Description of profession "Captain" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were the captain of your small ship, making a living by driving divers "
"and tourists around the sea.  The last excursion went wrong after your "
"passengers tried a mutiny, but you managed to escape with your precious ship"
" intact."
msgstr "你是一艘小船的船长，靠带着潜水员和游客海上观光为生。你最后一次远航出了问题，你的乘客试图哗变，但你成功逃脱了，而且你珍贵的小船完好无损。"

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Captain"
msgstr "船长"

#. ~ Description of profession "Captain" for female
#: data/json/professions.json
