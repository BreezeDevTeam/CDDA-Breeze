#. ~ Description of "skull bowl"
#: data/json/items/containers.json
msgid "A macabre-looking bowl made from the upper part of a skull."
msgstr "用头骨上半部分制成的碗，看起来很恐怖。“我要拿你的头盖骨当碗使”"

#. ~ Item name
#: data/json/items/containers.json
msgid "cigarette pack"
msgid_plural "cigarette packs"
msgstr[0] "香烟盒"

#. ~ Description of "cigarette pack"
